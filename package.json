{
  "name": "34b-ninja",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first browser art uploader and BIO/SAO lab for the DEF CON 34 badge.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "og:render": "node scripts/render-og-card.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "npm run test:unit",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "check": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "web-serial-polyfill": "1.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.2.1"
  }
}
